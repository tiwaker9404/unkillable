# Postgres 13+ (local, Neon, Supabase, RDS...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unkillable

# Comma-separated API keys. Empty = unauthenticated (dev only).
# Generate one: node -e "console.log('uk_' + crypto.randomBytes(24).toString('base64url'))"
API_KEYS=

PORT=8080
LOG_LEVEL=info

# Workers
WORKER_CONCURRENCY=16
LEASE_MS=30000
RUN_MAX_ATTEMPTS=10
RETRY_BASE_MS=2000
RETRY_MAX_MS=600000

# LLM: "scripted" (free, deterministic) or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=scripted
# Local Ollama:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# Demo agent
SANDBOX_URL=http://127.0.0.1:4000
APPROVAL_THRESHOLD_CENTS=20000

# Baseline for comparison: durable | naive
EXECUTION_MODE=durable

# Chaos testing only: probability a worker SIGKILLs itself right after a side effect
CHAOS_KILL_AFTER_EFFECT=0
